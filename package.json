{
  "name": "flownote",
  "version": "1.0.0",
  "main": "./dist-electron/main.js",
  "scripts": {
    "dev": "vite --port 5182",
    "electron:dev": "tsc -p electron/tsconfig.json && electron .",
    "start": "concurrently \"npm run dev\" \"wait-on http://localhost:5182 && npm run electron:dev\"",
    "build": "tsc -p electron/tsconfig.json && vite build",
    "clean": "rimraf dist dist-electron",
    "build:native": "bash scripts/build-native-binary.sh",
    "build:notch-probe": "bash scripts/build-notch-probe.sh",
    "app:build": "npm run build && electron-builder",
    "app:build:mac": "npm run build && electron-builder --mac",
    "admin:dev": "cd admin && npm run dev"
  },
  "build": {
    "appId": "com.flownote.app",
    "productName": "Flownote",
    "icon": "public/icon.icns",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "custom-binaries/audiotee",
        "to": "audiotee"
      },
      {
        "from": ".env.production",
        "to": ".env"
      }
    ],
    "asarUnpack": [
      "custom-binaries/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Flownote needs microphone access to detect questions in real time.",
        "NSAudioCaptureUsageDescription": "Flownote needs system audio access to detect interview questions from other participants.",
        "NSScreenCaptureDescription": "Flownote needs Screen & System Audio Recording permission to capture system audio."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "compression": "maximum",
    "afterPack": "./scripts/afterPack.js",
    "publish": {
      "provider": "github",
      "owner": "itsukison",
      "repo": "flownote",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@fontsource-variable/eb-garamond": "^5.2.7",
    "@fontsource-variable/inter-tight": "^5.2.7",
    "@fontsource/geist-sans": "^5.2.5",
    "@google/genai": "^1.25.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.98.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.11.0",
    "node-cron": "^4.2.1",
    "openai": "^6.25.0",
    "pdfjs-dist": "^5.5.207",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "unpdf": "^1.4.0",
    "uuid": "^11.0.3",
    "ws": "^8.17.1"
  }
}
